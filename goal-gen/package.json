{
  "name": "goal-gen",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted GOAL generator — see docs/prd.md. This is the initial scaffold (eval harness first, per ADR-0013).",
  "bin": {
    "goal-gen": "bin/goal-gen.mjs"
  },
  "files": [
    "bin/",
    "backend/src/",
    "packs/",
    "policies/",
    "schemas/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run tests/evals",
    "eval:planner": "vitest run tests/evals/planner",
    "typecheck": "tsc --noEmit",
    "runner": "tsx backend/src/runner.ts",
    "cli": "tsx backend/src/cli/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "js-yaml": "^4.3.2",
    "pg": "^8.22.0",
    "tsx": "^4.19.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.6",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^3.23.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
