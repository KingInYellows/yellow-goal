{
  "schemaVersion": "yellow-goal/pack/v1",
  "id": "repository-goal-packet",
  "version": "1.0.0",
  "description": "Evidence-backed repository assessment, goal resolution, milestone, and orchestrator packet.",
  "compatibleEngine": ">=0.1.0 <1.0.0",
  "requiredSchemas": {
    "request": "yellow-goal/request/v1",
    "repoProfile": "yellow-goal/repo-profile/v1",
    "evidence": "yellow-goal/evidence/v1",
    "finding": "yellow-goal/finding/v1",
    "goalResolution": "yellow-goal/goal-resolution/v1",
    "milestone": "yellow-goal/milestone/v1",
    "orchestration": "yellow-goal/orchestration/v1",
    "manifest": "yellow-goal/packet-manifest/v1",
    "assessment": "yellow-goal/repository-assessment/v1"
  },
  "defaultPolicy": "compiler-read-only",
  "requiredOutputs": [
    "00_START_HERE.md",
    "01_EXECUTIVE_JUDGMENT.md",
    "02_REPOSITORY_STATE.md",
    "03_FINDINGS.md",
    "04_GOAL_RESOLUTION.md",
    "05_MILESTONE.md",
    "06_ORCHESTRATION.md",
    "07_VALIDATION_PLAN.md",
    "08_HUMAN_GATES.md",
    "evidence/evidence.jsonl",
    "evidence/repository-profile.json",
    "evidence/research-sources.json",
    "research/external-research.jsonl",
    "contracts/request.json",
    "contracts/repository-assessment.json",
    "contracts/goal-resolution.json",
    "contracts/milestone.json",
    "contracts/orchestration.json",
    "prompts/MASTER_IMPLEMENTATION_PROMPT.md",
    "prompts/PERSISTENT_GOAL.txt",
    "prompts/REVIEW_PROMPT.md",
    "templates/FINDING_LEDGER.md",
    "templates/VALIDATION_MATRIX.md",
    "templates/FINAL_HANDOFF.md",
    "scripts/preflight.sh",
    "scripts/preflight.ps1",
    "scripts/launch.sh",
    "scripts/launch.ps1",
    "MANIFEST.json",
    "CHECKSUMS.sha256"
  ]
}
