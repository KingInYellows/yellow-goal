{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yellow-goal.local/schemas/orchestration/v1",
  "title": "OrchestrationSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "provider",
    "lead",
    "teamMode",
    "fallbackMode",
    "waves",
    "maxConcurrentWorkers",
    "mutationBoundaries",
    "validationOwnership",
    "stopConditions",
    "humanApproval"
  ],
  "properties": {
    "schemaVersion": {
      "const": "yellow-goal/orchestration/v1"
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "description": "The resolved OrchestrationProfile.id this spec's model roles were bound from (e.g. claude-fable-opus-sonnet@1) — see schemas/app/orchestration-profile.schema.json."
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "lead": {
      "type": "object",
      "required": [
        "role",
        "modelRole",
        "modelId",
        "responsibilities"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "modelRole": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Must include sole-integrator/final-decision-maker semantics — enforced at the zod contract layer (contracts/orchestration.ts), not structurally here."
        }
      }
    },
    "teamMode": {
      "enum": [
        "agent-team-preferred"
      ]
    },
    "fallbackMode": {
      "enum": [
        "subagents"
      ]
    },
    "waves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/wave"
      }
    },
    "maxConcurrentWorkers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "exclusiveFileOwnership": {
      "type": "boolean",
      "default": true
    },
    "requirePlanApproval": {
      "type": "boolean",
      "default": true
    },
    "mutationBoundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "What teammates may never do: stage, commit, push, merge, resolve review threads, change permissions, deploy."
    },
    "validationOwnership": {
      "type": "string",
      "minLength": 1,
      "description": "Who runs final validation before integration — the lead."
    },
    "stopConditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "humanApproval": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "maxActive",
        "readOnly",
        "requiresPlanApproval",
        "freshContext",
        "teammates"
      ],
      "properties": {
        "name": {
          "enum": [
            "investigation",
            "implementation",
            "verification"
          ]
        },
        "maxActive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "readOnly": {
          "type": "boolean"
        },
        "requiresPlanApproval": {
          "type": "boolean"
        },
        "freshContext": {
          "type": "boolean"
        },
        "teammates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/teammate"
          }
        }
      }
    },
    "teammate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "modelRole",
        "modelId",
        "ownership"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "modelRole": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "ownership": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
