# GOAL Generator — environment template. Copy to `.env` (gitignored).
# NONE of these are needed for M0 (the planner is pure). Secrets live ONLY on the host
# (ADR-0011); never commit real values.

# --- M1+ persistence ---
# Postgres (relational now; pgvector at M3)
# DATABASE_URL=postgres://goal:goal@localhost:5432/goal_gen

# --- Web auth (ADR-0011): single-admin login. Set a strong value on the host. ---
# ADMIN_TOKEN=

# --- Executors (ADR-0006): CLIs authenticate via their own local login on the host. ---
# Optional API-key fallback for sustained/parallel load (else uses your subscription):
# ANTHROPIC_API_KEY=

# --- Guardrail overrides (defaults in docs/decisions/0010-guardrail-defaults.md) ---
# MAX_BUDGET_USD=20
# MAX_REPLANS=5
# MAX_REEXTRACTIONS=2
# MAX_WALLCLOCK_MIN=60
