{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run eval:*)",
      "Bash(npm run test:operator-recipe:*)",
      "Bash(npm run cli -- version:*)",
      "Bash(npm run cli -- capabilities:*)"
    ],
    "deny": [
      "Bash(npm run runner:*)",
      "Bash(npm run cli -- run approve:*)",
      "Bash(goal-gen run approve:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-live-executor.mjs"
          }
        ]
      }
    ]
  }
}
